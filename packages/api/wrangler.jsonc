{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypefuel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [{"pattern": "api.hypefuel.me", "custom_domain": true}],
  // Declaring a route otherwise turns the workers.dev subdomain off, and that address was
  // published as the API before the domain existed. The docs point at api.hypefuel.me.
  "workers_dev": true,
  "vars": {
    "FUEL_ADDRESS": "0x42b06b1d9a07Fc3925C518dbf9475E7cA80DC8DF",
    "RPC_URL": "https://rpc.hyperliquid.xyz/evm",
    "ALLOWED_ORIGINS": "*"
  },
  // Rebalancing keeper. Every minute, because an empty faucet is user-visible and a run that
  // has nothing to do is a single eth_call.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // RELAYER_PRIVATE_KEY is a secret: `wrangler secret put RELAYER_PRIVATE_KEY`.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        // 30 requests per minute per IP, enough for normal use but not for scripted abuse.
        "simple": {"limit": 30, "period": 60}
      }
    ]
  }
}
