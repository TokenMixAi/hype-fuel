{
  "name": "@hypefuel/sdk",
  "version": "0.1.0",
  "description": "Build, sign and price HypeFuel orders. Works in browsers, Node and Cloudflare Workers.",
  "license": "MIT",
  "keywords": ["hyperevm", "hyperliquid", "hype", "usdc", "eip-3009", "gasless", "viem"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chase-mew/hype-fuel.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://hypefuel.me/docs",
  "bugs": "https://github.com/chase-mew/hype-fuel/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "viem": "^2.21.0",
    "vitest": "^2.1.4"
  }
}
