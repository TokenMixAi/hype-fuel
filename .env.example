# Wallet used to deploy the contract and to relay fills. Needs HYPE for gas.
# Keep this out of version control; .gitignore already excludes .env.
PRIVATE_KEY=0x

# Deployed HypeFuel proxy, used by the live test scripts.
FUEL_ADDRESS=0x42b06b1d9a07Fc3925C518dbf9475E7cA80DC8DF

# Relayer base URL, used by packages/api/scripts/live-api-fill.ts.
API_URL=https://api.hypefuel.me

# Etherscan V2 key, used by `forge verify-contract`. Covers HyperEVM as chain 999.
ETHERSCAN_API_KEY=
